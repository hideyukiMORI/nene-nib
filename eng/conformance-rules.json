  "platformHeaders": ["windows.h", "Windows.h", "winuser.h", "wingdi.h", "fileapi.h", "processthreadsapi.h", "winsock2.h", "shlobj.h", "d2d1.h", "d2d1_1.h", "d2d1_3.h", "dwrite.h", "dwrite_3.h", "dxgi.h", "dxgi1_6.h", "d3d11.h", "dcomp.h", "dwmapi.h", "imm32.h", "imm.h", "cstdio", "iostream", "fstream", "filesystem", "ctime", "clocale", "locale"],
  "concurrencyHeaders": ["thread", "jthread", "mutex", "shared_mutex", "condition_variable", "future", "atomic", "semaphore", "latch", "barrier", "stop_token", "process.h", "synchapi.h"],
  "concurrencyAllowedPath": "src/adapters/win32/",
  "simdHeaders": ["immintrin.h", "intrin.h", "xmmintrin.h", "emmintrin.h", "pmmintrin.h", "tmmintrin.h", "smmintrin.h", "nmmintrin.h", "wmmintrin.h", "ammintrin.h", "arm_neon.h"],
