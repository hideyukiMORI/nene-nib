{
  "typeSuffixes": ["manager", "helper", "util", "utils", "common"],
  "moduleNames": ["utils", "helpers", "managers", "misc", "common"],
  "suppressionPragmaPattern": "#\\s*pragma\\s+(warning|clang\\s+diagnostic|GCC\\s+diagnostic)|\\b(?:__pragma|_Pragma)\\s*\\(",
  "broadSuppressionPattern": "\\bNOLINT(?:BEGIN|END)?\\b",
  "lineSuppressionToken": "NOLINTNEXTLINE",
  "lineSuppressionPattern": "NOLINTNEXTLINE\\([A-Za-z0-9,.-]+\\)",
  "taskMarkerPattern": "\\b(?:TODO|FIXME)\\b",
  "forbiddenFileWords": ["baseline", "suppressions"],
  "disabledGatePatterns": ["(?i)/W[0-3](?![0-9])", "(?i)/WX-", "(?i)/wd[0-9]+", "(?<![\\w-])-Wno-error(?:=|\\b)", "(?<![\\w-])-w(?![\\w-])", "(?i)\\bignoreFailures\\s*[:=]\\s*true", "(?i)continue-on-error\\s*:\\s*true", "(?i)--exit-zero\\b", "(?i)--line-filter", "(?i)--exclude-header-filter", "(?i)WarningsAsErrors:\\s*['\"]{2}"],
